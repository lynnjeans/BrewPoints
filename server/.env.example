# BrewPoints server configuration.
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored — never commit real secrets.

# --- Core ---
# MongoDB connection string. Multi-document transactions (R2) require a REPLICA SET:
#   - Local dev: run a single-node replica set (see DB_SETUP.md), then use:
#       mongodb://127.0.0.1:27017/brewpoints?replicaSet=rs0
#   - Production: MongoDB Atlas (already a replica set), e.g.:
#       mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/brewpoints?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/brewpoints?replicaSet=rs0"

# Secret used to sign session JWTs. MUST be a long, random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# --- Google OAuth ---
# Required before Task 2.2 (leave blank until then).
# Create these in the Google Cloud Console yourself — the agent does not.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Web Push (Task 05) ---
# Generate a key pair once with: npm run vapid:generate
# Then paste the values here. The public key is also exposed to the client.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@brewpoints.local"

# --- Loyalty rules ---
# Stamps required for one free coffee.
STAMPS_FOR_FREE_COFFEE=10

# --- Optional (defaults shown) ---
# PORT=3001
# NODE_ENV=development
